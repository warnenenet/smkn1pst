# ==============================================================================
# Konfigurasi Lingkungan Docker All-in-One (Absensi SMK Face AI)
# Server Target: 8 Core / 16 Thread, 32 GB RAM, 8 Kamera RTSP 1080p@10fps
# ==============================================================================

# 1. Port host untuk Web / Dashboard (akses via http://127.0.0.1:HOST_PORT atau Reverse Proxy)
# Gunakan 3080 untuk produksi (atau port lain yang belum terpakai jika uji coba side-by-side)
HOST_PORT=3080

# 2. Batas Resource Container Docker (pagar pengaman stabilitas sistem)
# DOCKER_CPU_LIMIT: 12 CPU logis (menyisakan 4 CPU logis untuk sistem host & background tasks)
DOCKER_CPU_LIMIT=12

# DOCKER_MEM_LIMIT: batas RAM container (face-engine + Node web + Baileys WA)
DOCKER_MEM_LIMIT=4g

# DOCKER_PIDS_LIMIT: batas jumlah thread/proses aktif untuk mencegah "flood proses"
# Jika container error "cannot create thread", naikkan menjadi 1024
DOCKER_PIDS_LIMIT=512

# 3. Tuning Parameter Engine Wajah Rust (face-engine)
# ORT_INTRA_THREADS: jumlah thread CPU per operasi inferensi ONNX Runtime
ORT_INTRA_THREADS=4

# MAX_CAMERA_WORKERS: jumlah task kamera yang didekode secara simultan (maksimal 8 kamera)
MAX_CAMERA_WORKERS=8

# PROCESS_EVERY_N_FRAMES: dekode 1 dari tiap N frame (input 10 FPS -> proses 5 FPS untuk efisiensi)
PROCESS_EVERY_N_FRAMES=2

# 4. Keamanan Startup: Pin SHA256 Model & Library ONNX Runtime (Opsional)
# Secara default, container otomatis memakai hash yang telah diverifikasi saat 'docker build'.
# Nilai ini sepenuhnya opsional dan TIDAK wajib diisi di form environment.
# Jika di kemudian hari ingin override manual, Anda dapat menambahkan:
# DET_MODEL_SHA256=
# REC_MODEL_SHA256=
# ORT_DYLIB_SHA256=


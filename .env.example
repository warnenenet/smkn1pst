# Tidak ada variabel environment yang wajib diisi manual oleh pengguna.
# Seluruh default konfigurasi sudah tertanam langsung di kode:
# - WA_GATEWAY_PORT = 8003, WA_MAX_CHROME = 3, WA_GATEWAY_URL = http://127.0.0.1:8003
# - Token internal dibangkitkan otomatis pada first boot dan dibaca langsung dari
#   file /app/storage/secrets/internal_token (atau <DATA_DIR>/secrets/internal_token).

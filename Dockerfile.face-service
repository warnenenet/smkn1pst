# ==============================================================================
# Stage 1: Build Rust Static Acceleration Binary (Cosine Similarity 1:N)
# ==============================================================================
FROM rust:1.83-slim-bookworm AS rust-builder
WORKDIR /build
COPY services/rust-accel ./
RUN cargo test --release && cargo build --release

# ==============================================================================
# Stage 2: Standalone Face AI Service (Python InsightFace buffalo_l + Rust)
# Untuk VPS aaPanel Non-Docker Node Project + Docker pendamping AI
# ==============================================================================
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Jakarta \
    PYTHONUNBUFFERED=1 \
    FACE_PORT=8001 \
    DATA_DIR=/app/data \
    WA_STORAGE_DIR=/app/storage \
    INSIGHTFACE_HOME=/app/models/insightface \
    RUST_ACCEL_BIN=/app/bin/face_accel \
    HOME=/tmp \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app/services/face-service

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg libgl1 libglib2.0-0 libgomp1 \
      curl ca-certificates tzdata \
      g++ python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY services/face-service/requirements.txt /app/services/face-service/requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install --no-cache-dir numpy==1.26.4 cython \
    && /opt/venv/bin/pip install --no-cache-dir -r /app/services/face-service/requirements.txt \
    && apt-get purge -y --auto-remove g++ python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Pre-download hanya modul detection (SCRFD) + recognition (ArcFace) buffalo_l agar hemat RAM/disk
RUN mkdir -p /app/models/insightface /app/bin /app/data/snapshots /app/storage/debug /app/storage/secrets \
    && /opt/venv/bin/python -c "from insightface.app import FaceAnalysis; app = FaceAnalysis(name='buffalo_l', root='/app/models/insightface', providers=['CPUExecutionProvider'], allowed_modules=['detection', 'recognition']); app.prepare(ctx_id=-1, det_size=(640, 640))"

COPY --from=rust-builder /build/target/release/face_accel /app/bin/face_accel
COPY services/face-service ./

RUN chmod +x /app/bin/face_accel \
    && chmod -R a+rX /opt/venv /app/models /app/bin /app/services

HEALTHCHECK --interval=20s --timeout=5s --start-period=25s --retries=3 \
  CMD curl -sf "http://127.0.0.1:${FACE_PORT:-8001}/health" || exit 1

CMD ["sh", "-c", "exec /opt/venv/bin/uvicorn main:app --host 127.0.0.1 --port ${FACE_PORT:-8001}"]
